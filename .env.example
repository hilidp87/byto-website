# Copy this file to .env and fill in your values. Never commit .env to git.

# PostgreSQL connection string (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Your production URL
NEXTAUTH_URL=https://your-domain.up.railway.app

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment provider: "mock" for now, swap for "zarinpal" etc. later
PAYMENT_PROVIDER=mock
